{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*",
      ],
      "@shared/*": [
        "./src/shared/*",
      ],
      "@entities/*": [
        "./src/entities/*",
      ],
      "@features/*": [
        "./src/features/*",
      ],
       "@pages/*": [
        "./src/pages/*",
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
